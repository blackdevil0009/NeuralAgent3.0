[Unit]
Description=VaidyaMed-X Backend API Server
After=network.target mysql.service
Wants=mysql.service

[Service]
User=root
Group=root
WorkingDirectory=/root/NeuralAgent3.0/backend
Environment="PATH=/root/NeuralAgent3.0/backend/venv/bin"

# ── Database credentials (NOT in .env — injected securely here) ──
Environment="DB_HOST=127.0.0.1"
Environment="DB_USER=root"
Environment="DB_PASSWORD=Devil@2007%"
Environment="DB_NAME=neuralagent_db"

# ── Authentication secrets ────────────────────────────────────────
Environment="JWT_SECRET_KEY=vaidyamedx-neural-agent-secret-key-2026!!"
Environment="HMAC_SECRET=neural-agent-hmac-key-2026"
Environment="AES_SECRET=neural-agent-aes-key-2026"

ExecStart=/root/NeuralAgent3.0/backend/venv/bin/gunicorn --worker-class geventwebsocket.gunicorn.workers.GeventWebSocketWorker --workers 1 --bind 0.0.0.0:5000 --timeout 120 --reuse-port app:app

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vaidyamed

[Install]
WantedBy=multi-user.target
